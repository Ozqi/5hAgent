# walle LLM 配置
#
# 读法：
#   1. 先设置 LLM_MODEL，格式固定为 <provider>/<model>。
#   2. 再填写同名 provider 配置块；provider=mygateway 就读取 LLM_MYGATEWAY_*。
#   3. model 会原样发给上游，可以继续带 /。
#
# 命名规则：
#   LLM_MODEL=<provider>/<model>
#   LLM_<PROVIDER>_FORMAT=claude|openai|codex
#   LLM_<PROVIDER>_BASE_URL=<接口地址>
#   LLM_<PROVIDER>_API_KEY=<密钥；本地服务可用 dummy>
#
# 临时切换不需要改文件：walle --model <provider>/<model>

# ==============================================================================
# 1. 当前模型：取消注释并填写一个模型引用
# ==============================================================================

# LLM_MODEL=<provider>/<model>

# ==============================================================================
# 2. Provider: OpenAI-compatible 网关模板
# ==============================================================================

# 把 MYGATEWAY 换成你的 provider 名的大写形式。
# 示例：provider=mygateway 时，LLM_MODEL 写 mygateway/<model>，配置块写 LLM_MYGATEWAY_*。
# BASE_URL 填平台文档给出的 OpenAI-compatible endpoint；很多网关以 /v1 结尾。
#
# LLM_MODEL=mygateway/<model>
# LLM_MYGATEWAY_FORMAT=openai
# LLM_MYGATEWAY_BASE_URL=https://example.com/v1
# LLM_MYGATEWAY_API_KEY=sk-...
# LLM_MYGATEWAY_MAX_TOKENS=4096
# LLM_MYGATEWAY_THINKING_BUDGET_TOKENS=0
# LLM_MYGATEWAY_STREAM=true

# ==============================================================================
# 3. Provider: 本地 OpenAI-compatible 服务模板
# ==============================================================================

# 本地服务也走同一套 provider 机制。下面用 local 作为 provider 名；
# 具体 model、BASE_URL 和启动命令以本地服务自己的文档为准。
#
# LLM_MODEL=local/<model>
# LLM_LOCAL_FORMAT=openai
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_API_KEY=dummy
# LLM_LOCAL_MAX_TOKENS=4096
# LLM_LOCAL_THINKING_BUDGET_TOKENS=0
# LLM_LOCAL_STREAM=true

# ==============================================================================
# 4. Provider: Claude / Anthropic Messages API 模板
# ==============================================================================

# LLM_MODEL=claude/<model>
# LLM_CLAUDE_FORMAT=claude
# LLM_CLAUDE_BASE_URL=https://api.anthropic.com
# LLM_CLAUDE_API_KEY=sk-ant-...
# LLM_CLAUDE_MAX_TOKENS=4096
# LLM_CLAUDE_THINKING_BUDGET_TOKENS=0
# LLM_CLAUDE_STREAM=true

# ==============================================================================
# 5. Provider: ChatGPT OAuth / Codex
# ==============================================================================

# ChatGPT OAuth 不从 .env 读取 API key。
# 在 TUI 输入 /provider openai 完成浏览器登录，再从 /model 选择账号可用模型。
# 也可以写 ~/.walle/settings.json：
#   {"default_model":"openai/<model>","default_auth":"chatgpt"}

# ==============================================================================
# Agent 行为配置
# ==============================================================================

AGENT_NAME=walle
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_REPEAT_TOOL_LIMIT=5
AGENT_CONTEXT_AUTO_COMPRESS=true
