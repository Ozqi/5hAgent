# walle LLM 配置
#
# 填写规则：
#   1. LLM_MODEL 写成 provider/model。
#   2. provider 对应下面的 LLM_<PROVIDER>_* 配置块。
#   3. model 会原样发送给上游 API，允许继续带 /，例如 openrouter/openai/gpt-4o-mini。

# 默认：本地 Ollama。安装后可直接启动；未安装模型时执行：ollama pull ornith:9b
LLM_MODEL=ollama/ornith:9b

LLM_OLLAMA_FORMAT=openai
LLM_OLLAMA_API_KEY=dummy
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OLLAMA_MAX_TOKENS=4096
LLM_OLLAMA_THINKING_BUDGET_TOKENS=0
LLM_OLLAMA_STREAM=true

# 示例：添加任意 OpenAI-compatible provider。
# 把 mygateway 换成你的 provider 名，然后把 LLM_MODEL 改成 mygateway/<model>。
# LLM_MODEL=mygateway/gpt-4o-mini
# LLM_MYGATEWAY_FORMAT=openai
# LLM_MYGATEWAY_API_KEY=sk-xxx
# LLM_MYGATEWAY_BASE_URL=https://example.com/v1
# LLM_MYGATEWAY_MAX_TOKENS=4096
# LLM_MYGATEWAY_THINKING_BUDGET_TOKENS=0
# LLM_MYGATEWAY_STREAM=true

# 示例：DeepSeek。
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_DEEPSEEK_FORMAT=openai
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MAX_TOKENS=4096
# LLM_DEEPSEEK_THINKING_BUDGET_TOKENS=0
# LLM_DEEPSEEK_STREAM=true

# 示例：OpenRouter。model 里可以继续带 /。
# LLM_MODEL=openrouter/openai/gpt-4o-mini
# LLM_OPENROUTER_FORMAT=openai
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_MAX_TOKENS=4096
# LLM_OPENROUTER_THINKING_BUDGET_TOKENS=0
# LLM_OPENROUTER_STREAM=true

# 示例：Claude / Anthropic。
# LLM_MODEL=claude/claude-sonnet-4-6
# LLM_CLAUDE_FORMAT=claude
# LLM_CLAUDE_API_KEY=sk-ant-xxx
# LLM_CLAUDE_BASE_URL=https://api.anthropic.com
# LLM_CLAUDE_MAX_TOKENS=4096
# LLM_CLAUDE_THINKING_BUDGET_TOKENS=0
# LLM_CLAUDE_STREAM=true

# 示例：ChatGPT OAuth / Codex Responses。
# 先在 TUI 输入 /provider openai 完成登录，再写 ~/.walle/settings.json：
# {"default_model":"openai/gpt-5.5","default_auth":"chatgpt"}

# Agent 行为配置
AGENT_NAME=walle
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_REPEAT_TOOL_LIMIT=5
AGENT_CONTEXT_AUTO_COMPRESS=true
