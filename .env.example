# 5hAgent LLM 配置
# 当前模型固定使用 provider/model 格式：
#   provider 选择下面的 LLM_<PROVIDER>_* 配置块
#   model 是原样发送给上游 API 的模型名
LLM_MODEL=mira/claude-opus-4-6

# Mira 本地代理；claude/openai 是接口协议格式，不是 provider。
LLM_MIRA_FORMAT=claude
LLM_MIRA_API_KEY=local
LLM_MIRA_BASE_URL=http://127.0.0.1:8787
LLM_MIRA_MAX_TOKENS=4096
LLM_MIRA_THINKING_BUDGET_TOKENS=0
LLM_MIRA_STREAM=true

# 备选：本地 Ollama OpenAI-compatible 接口。
# 使用时改为：LLM_MODEL=ollama/qwen3:14b
# LLM_OLLAMA_FORMAT=openai
# LLM_OLLAMA_API_KEY=dummy
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_OLLAMA_MAX_TOKENS=4096
# LLM_OLLAMA_THINKING_BUDGET_TOKENS=0
# LLM_OLLAMA_STREAM=true

# 备选：DeepSeek OpenAI-compatible API。
# 使用时可直接在 TUI 里 /provider deepseek；模型列表从 https://api.deepseek.com/models 拉取。
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_DEEPSEEK_FORMAT=openai
# LLM_DEEPSEEK_API_KEY=sk-...
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MAX_TOKENS=4096
# LLM_DEEPSEEK_THINKING_BUDGET_TOKENS=0
# LLM_DEEPSEEK_STREAM=true

# Agent 行为配置
AGENT_NAME=5hAgent
AGENT_MAX_TOTAL_TOKENS=200000
AGENT_REPEAT_TOOL_LIMIT=5
AGENT_CONTEXT_AUTO_COMPRESS=true
