#compdef 5hagent

_5hagent() {
  if (( CURRENT == 2 )); then
    local -a commands=(
      'attach:Follow a running Agent process'
      'daemon:Run the Agent Systemd task supervisor'
      'ps:List running Agent processes'
      'run:Run one file-backed task'
    )
    _describe command commands
    return
  fi

  if [[ ${words[2]} == attach && CURRENT == 3 ]]; then
    local line
    local -a processes
    for line in "${(@f)$(5hagent __complete attach "$PREFIX" 2>/dev/null)}"; do
      [[ $line == :* ]] && continue
      processes+=("${line//$'\t'/:}")
    done
    _describe process processes
  fi
}

compdef _5hagent 5hagent
