{
  "拓扑": "5hAgent 当前运行时拓扑",
  "说明": "这是解释性 topology.json，不是代码接口 schema。字段和关系基于当前代码与 doc/ 下模块文档整理。",
  "节点": [
    {
      "id": "cmd_main",
      "名称": "cmd/5hagent/main.go",
      "类型": "module",
      "角色": [
        "CLI 入口",
        "解析全局 flag",
        "分发 TUI/run/daemon 子命令"
      ]
    },
    {
      "id": "runtime",
      "名称": "internal/runtime",
      "类型": "module",
      "角色": [
        "装配配置、LLM、Agent、Context、TaskList、Tools",
        "支撑 TUI、headless 和 daemon 共用运行链路"
      ]
    },
    {
      "id": "cli_tui",
      "名称": "internal/cli",
      "类型": "module",
      "角色": [
        "Bubble Tea TUI",
        "渲染历史、输入框、状态行",
        "处理 slash 命令和工具事件提示"
      ]
    },
    {
      "id": "commands",
      "名称": "internal/commands",
      "类型": "module",
      "角色": [
        "处理 /task、/skill、/compress、/mcp 等 TUI 内部命令"
      ]
    },
    {
      "id": "agent",
      "名称": "internal/agent",
      "类型": "module",
      "角色": [
        "ReAct 主循环",
        "模型调用",
        "ToolCall 收集和执行",
        "assistant/tool 消息写回"
      ]
    },
    {
      "id": "context",
      "名称": "internal/context",
      "类型": "module",
      "角色": [
        "消息内存",
        "session JSONL 持久化",
        "压缩",
        "inspect/pin/edit/audit 元数据"
      ]
    },
    {
      "id": "llm",
      "名称": "internal/llm",
      "类型": "module",
      "角色": [
        "按 provider 配置创建 Eino ChatModel",
        "屏蔽 Claude/OpenAI-compatible 初始化差异",
        "探测 Ollama 实际 context window"
      ]
    },
    {
      "id": "tools_registry",
      "名称": "internal/tools.Registry",
      "类型": "module",
      "角色": [
        "注册本地工具",
        "维护工具元数据",
        "绑定 context.context",
        "显式注册 MCP 工具"
      ]
    },
    {
      "id": "base_tools",
      "名称": "base.* tools",
      "类型": "module",
      "角色": [
        "read_file/read_md/write_file/edit/glob/grep/list_dir/exec_shell"
      ]
    },
    {
      "id": "context_tool",
      "名称": "context.context",
      "类型": "module",
      "角色": [
        "LLM 可调用上下文工具",
        "inspect/pin/edit/audit/compress 当前 message context"
      ]
    },
    {
      "id": "task_tool",
      "名称": "task.task",
      "类型": "module",
      "角色": [
        "LLM 可调用任务工具",
        "管理 .5hagent/task.md"
      ]
    },
    {
      "id": "skill_tool",
      "名称": "skill.skill",
      "类型": "module",
      "角色": [
        "LLM 可调用 skill 查询工具",
        "读取已加载 skill 快照"
      ]
    },
    {
      "id": "mcp_tools",
      "名称": "mcp.* tools",
      "类型": "external",
      "角色": [
        "MCP 远端工具适配",
        "当前不是默认启动可见工具"
      ]
    },
    {
      "id": "task",
      "名称": "internal/task",
      "类型": "module",
      "角色": [
        ".5hagent/task.md 解析、CRUD、状态流转、归档恢复"
      ]
    },
    {
      "id": "skill",
      "名称": "internal/skill",
      "类型": "module",
      "角色": [
        "启动时加载全局和项目 SKILL.md",
        "项目同名 skill 覆盖全局 skill",
        "Agent 生命周期内固定"
      ]
    },
    {
      "id": "systemd",
      "名称": "internal/systemd",
      "类型": "module",
      "角色": [
        "最小 AgentProcess 调度核心",
        "消费 task.created 事件",
        "串行启动进程"
      ]
    },
    {
      "id": "event_source_task",
      "名称": "internal/runtime/event_source_task.go",
      "类型": "module",
      "角色": [
        "把 task.md 文件变化转换为 task.created 事件"
      ]
    },
    {
      "id": "logger",
      "名称": "internal/logger",
      "类型": "module",
      "角色": [
        "日志输出",
        "ToolEvent 格式化",
        "TUI/headless/worklog 工具事件来源"
      ]
    },
    {
      "id": "hooks",
      "名称": "Runtime Hooks",
      "类型": "module",
      "角色": [
        "监听 tool_start/tool_end/tool_error",
        "异步执行项目 hooks.json 中的命令"
      ]
    },
    {
      "id": "session_store",
      "名称": "~/.5hAgent/sessions/*.jsonl",
      "类型": "storage",
      "角色": [
        "TUI/headless message session 持久化"
      ]
    },
    {
      "id": "project_task_file",
      "名称": "<project>/.5hagent/task.md",
      "类型": "storage",
      "角色": [
        "headless/daemon 任务真源"
      ]
    },
    {
      "id": "reports",
      "名称": "<project>/.5hagent/reports/*.md",
      "类型": "storage",
      "角色": [
        "headless task report",
        "daemon process report"
      ]
    },
    {
      "id": "worklogs",
      "名称": "<project>/.5hagent/agents/*/logs/*.md",
      "类型": "storage",
      "角色": [
        "headless/process 工作日志",
        "assistant token 与工具事件记录"
      ]
    },
    {
      "id": "config_env",
      "名称": "~/.5hAgent/.env",
      "类型": "config",
      "角色": [
        "LLM_MODEL",
        "LLM_<PROVIDER>_*",
        "AGENT_* 配置"
      ]
    },
    {
      "id": "prompt_files",
      "名称": "~/.5hAgent/prompt/*.md",
      "类型": "config",
      "角色": [
        "main/tui/compress/prefix prompt"
      ]
    }
  ],
  "边": [
    {
      "id": "cmd_main->runtime",
      "from": "cmd_main",
      "to": "runtime",
      "关系": "sync_call",
      "label": "runtime.New / NewInMemory"
    },
    {
      "id": "cmd_main->cli_tui",
      "from": "cmd_main",
      "to": "cli_tui",
      "关系": "sync_call",
      "label": "LaunchTUI"
    },
    {
      "id": "cmd_main->systemd",
      "from": "cmd_main",
      "to": "systemd",
      "关系": "sync_call",
      "label": "daemon"
    },
    {
      "id": "runtime->config_env",
      "from": "runtime",
      "to": "config_env",
      "关系": "read",
      "label": "LoadConfigWithOptions"
    },
    {
      "id": "runtime->prompt_files",
      "from": "runtime",
      "to": "prompt_files",
      "关系": "read",
      "label": "LoadSystemPromptBase"
    },
    {
      "id": "runtime->project_task_file",
      "from": "runtime",
      "to": "project_task_file",
      "关系": "read_write",
      "label": "task.NewTaskList"
    },
    {
      "id": "runtime->session_store",
      "from": "runtime",
      "to": "session_store",
      "关系": "read_write",
      "label": "context.NewManager"
    },
    {
      "id": "runtime->llm",
      "from": "runtime",
      "to": "llm",
      "关系": "sync_call",
      "label": "llm.NewClient"
    },
    {
      "id": "runtime->agent",
      "from": "runtime",
      "to": "agent",
      "关系": "sync_call",
      "label": "agent.NewAgent / SetModel / SetTools"
    },
    {
      "id": "runtime->tools_registry",
      "from": "runtime",
      "to": "tools_registry",
      "关系": "sync_call",
      "label": "Registry.Init / RegisterContextTool / bindTools"
    },
    {
      "id": "runtime->hooks",
      "from": "runtime",
      "to": "hooks",
      "关系": "sync_call",
      "label": "loadHookManager / handleToolEvent"
    },
    {
      "id": "tools_registry->base_tools",
      "from": "tools_registry",
      "to": "base_tools",
      "关系": "depends_on",
      "label": "register base tools"
    },
    {
      "id": "tools_registry->task_tool",
      "from": "tools_registry",
      "to": "task_tool",
      "关系": "depends_on",
      "label": "register task.task"
    },
    {
      "id": "tools_registry->skill_tool",
      "from": "tools_registry",
      "to": "skill_tool",
      "关系": "depends_on",
      "label": "register skill.skill"
    },
    {
      "id": "tools_registry->context_tool",
      "from": "tools_registry",
      "to": "context_tool",
      "关系": "depends_on",
      "label": "register context.context"
    },
    {
      "id": "tools_registry->mcp_tools",
      "from": "tools_registry",
      "to": "mcp_tools",
      "关系": "depends_on",
      "label": "RegisterMCPTools only when explicitly connected"
    },
    {
      "id": "agent->llm",
      "from": "agent",
      "to": "llm",
      "关系": "sync_call",
      "label": "model.Stream / model.Generate"
    },
    {
      "id": "agent->context",
      "from": "agent",
      "to": "context",
      "关系": "read_write",
      "label": "GetMessages / AddMessage"
    },
    {
      "id": "agent->tools_registry",
      "from": "agent",
      "to": "tools_registry",
      "关系": "sync_call",
      "label": "toolMap lookup / invoke tool"
    },
    {
      "id": "agent->skill",
      "from": "agent",
      "to": "skill",
      "关系": "read",
      "label": "inject enabled skills on empty context"
    },
    {
      "id": "context->session_store",
      "from": "context",
      "to": "session_store",
      "关系": "read_write",
      "label": "Store.Append / ReplaceMessages"
    },
    {
      "id": "context_tool->context",
      "from": "context_tool",
      "to": "context",
      "关系": "read_write",
      "label": "inspect / pin / edit / audit / compress"
    },
    {
      "id": "task_tool->task",
      "from": "task_tool",
      "to": "task",
      "关系": "sync_call",
      "label": "ExecuteTaskAction"
    },
    {
      "id": "task->project_task_file",
      "from": "task",
      "to": "project_task_file",
      "关系": "read_write",
      "label": "managed block"
    },
    {
      "id": "skill_tool->skill",
      "from": "skill_tool",
      "to": "skill",
      "关系": "read",
      "label": "list/get current skill snapshot"
    },
    {
      "id": "cli_tui->commands",
      "from": "cli_tui",
      "to": "commands",
      "关系": "sync_call",
      "label": "slash commands"
    },
    {
      "id": "cli_tui->agent",
      "from": "cli_tui",
      "to": "agent",
      "关系": "sync_call",
      "label": "RunStream"
    },
    {
      "id": "cli_tui->runtime",
      "from": "cli_tui",
      "to": "runtime",
      "关系": "sync_call",
      "label": "/run and /model callbacks"
    },
    {
      "id": "agent->logger",
      "from": "agent",
      "to": "logger",
      "关系": "async_event",
      "label": "ToolEvent call/result/error"
    },
    {
      "id": "logger->cli_tui",
      "from": "logger",
      "to": "cli_tui",
      "关系": "async_event",
      "label": "toolEventMsg"
    },
    {
      "id": "logger->worklogs",
      "from": "logger",
      "to": "worklogs",
      "关系": "write",
      "label": "headless/process tool events"
    },
    {
      "id": "hooks->logger",
      "from": "hooks",
      "to": "logger",
      "关系": "read",
      "label": "consume stable tool events"
    },
    {
      "id": "runtime->reports",
      "from": "runtime",
      "to": "reports",
      "关系": "write",
      "label": "writeReport / writeProcessReport"
    },
    {
      "id": "runtime->worklogs",
      "from": "runtime",
      "to": "worklogs",
      "关系": "write",
      "label": "newHeadlessWorkLog"
    },
    {
      "id": "event_source_task->project_task_file",
      "from": "event_source_task",
      "to": "project_task_file",
      "关系": "read",
      "label": "poll mtime/size"
    },
    {
      "id": "event_source_task->systemd",
      "from": "event_source_task",
      "to": "systemd",
      "关系": "trigger",
      "label": "task.created"
    },
    {
      "id": "systemd->runtime",
      "from": "systemd",
      "to": "runtime",
      "关系": "sync_call",
      "label": "ProcessRunner.RunProcess"
    },
    {
      "id": "systemd->reports",
      "from": "systemd",
      "to": "reports",
      "关系": "write",
      "label": "process report path carried by AgentProcess"
    }
  ],
  "视图": [
    {
      "id": "startup_view",
      "名称": "启动装配视图",
      "包含节点": [
        "cmd_main",
        "runtime",
        "config_env",
        "prompt_files",
        "llm",
        "agent",
        "tools_registry",
        "context",
        "task",
        "skill"
      ],
      "包含边": [
        "cmd_main->runtime",
        "runtime->config_env",
        "runtime->prompt_files",
        "runtime->llm",
        "runtime->agent",
        "runtime->tools_registry",
        "runtime->project_task_file",
        "runtime->session_store"
      ],
      "边界": "从 CLI 入口进入 runtime.New，到 Agent 绑定 model/tools 完成。"
    },
    {
      "id": "tui_view",
      "名称": "TUI 交互视图",
      "包含节点": [
        "cmd_main",
        "runtime",
        "cli_tui",
        "commands",
        "agent",
        "context",
        "logger"
      ],
      "包含边": [
        "cmd_main->cli_tui",
        "cli_tui->commands",
        "cli_tui->agent",
        "cli_tui->runtime",
        "agent->context",
        "agent->logger",
        "logger->cli_tui"
      ],
      "边界": "用户输入、slash 命令、模型输出和工具事件渲染。"
    },
    {
      "id": "react_tool_view",
      "名称": "ReAct 与工具视图",
      "包含节点": [
        "agent",
        "llm",
        "context",
        "tools_registry",
        "base_tools",
        "task_tool",
        "skill_tool",
        "context_tool",
        "logger"
      ],
      "包含边": [
        "agent->llm",
        "agent->context",
        "agent->tools_registry",
        "tools_registry->base_tools",
        "tools_registry->task_tool",
        "tools_registry->skill_tool",
        "tools_registry->context_tool",
        "context_tool->context",
        "agent->logger"
      ],
      "边界": "一次 RunStream/RunStreamWithOptions 内的模型调用、工具调用和消息写回。"
    },
    {
      "id": "headless_view",
      "名称": "Headless 任务视图",
      "包含节点": [
        "cmd_main",
        "runtime",
        "task",
        "project_task_file",
        "agent",
        "reports",
        "worklogs",
        "logger"
      ],
      "包含边": [
        "cmd_main->runtime",
        "runtime->project_task_file",
        "runtime->agent",
        "runtime->reports",
        "runtime->worklogs",
        "agent->logger",
        "logger->worklogs"
      ],
      "边界": "5hagent run 从 task.md 选择任务，执行后写 report/worklog 并更新任务状态。"
    },
    {
      "id": "daemon_view",
      "名称": "Daemon / Agent Systemd 视图",
      "包含节点": [
        "cmd_main",
        "runtime",
        "event_source_task",
        "project_task_file",
        "systemd",
        "agent",
        "reports",
        "worklogs"
      ],
      "包含边": [
        "cmd_main->systemd",
        "event_source_task->project_task_file",
        "event_source_task->systemd",
        "systemd->runtime",
        "runtime->reports",
        "runtime->worklogs"
      ],
      "边界": "5hagent daemon 监听 task.md，把 pending/in_progress 任务转为 AgentProcess 执行。"
    },
    {
      "id": "persistence_view",
      "名称": "持久化视图",
      "包含节点": [
        "context",
        "session_store",
        "task",
        "project_task_file",
        "runtime",
        "reports",
        "worklogs"
      ],
      "包含边": [
        "context->session_store",
        "task->project_task_file",
        "runtime->reports",
        "runtime->worklogs"
      ],
      "边界": "用户会话、任务真源、执行报告和 worklog 的落盘边界。"
    }
  ],
  "结论": [
    "runtime 是装配层，不承载 ReAct 细节和 TUI 渲染。",
    "agent 是 ReAct 执行核心，通过 context 管理消息，通过 tools.Registry 调用工具。",
    "TUI、headless、daemon 共享同一套 runtime/agent/tools/context/task 组件。",
    "默认启动只注册本地工具和 context.context，不启动 MCP stdio server。",
    "session、task、report、worklog 是四类不同持久化边界。"
  ]
}
