{
  "拓扑": "walle 当前运行时拓扑",
  "生成": {
    "模型": "Claude Fable 5",
    "日期": "2026-08-23",
    "证据": [
      "cmd/walle/main.go",
      "cmd/walle/interactive_command.go",
      "cmd/walle/process_commands.go",
      "internal/runtime/runtime.go",
      "internal/runtime/daemon_session.go",
      "internal/systemd/systemd.go",
      "internal/systemd/control.go",
      "internal/tools/registry.go",
      "internal/tui/app.go",
      "internal/tui/commands.go"
    ]
  },
  "节点": [
    {"id":"cli","名称":"cmd/walle","类型":"client","角色":["默认启动或复用 daemon 并 attach","提供 daemon/ps/attach 命令"]},
    {"id":"tui","名称":"internal/tui","类型":"client","角色":["Bubble Tea 输入与渲染","消费远端 ProcessEvent"]},
    {"id":"daemon","名称":"walle daemon","类型":"host","角色":["固定托管 attachable interactive Agent","创建 Runtime、DaemonSession 和 control server"]},
    {"id":"socket","名称":"~/.walle/run/supervisor.sock","类型":"ipc","角色":["NDJSON list/attach/input/stop 控制通道"]},
    {"id":"runtime","名称":"internal/runtime","类型":"module","角色":["装配配置、Context、LLM、Agent、Tools、Skill","实现通用 ProcessRunner"]},
    {"id":"daemon_session","名称":"internal/runtime.DaemonSession","类型":"adapter","角色":["长驻交互会话","事件历史与订阅"]},
    {"id":"systemd","名称":"internal/systemd","类型":"module","角色":["通用 process.start 调度","AgentProcess 内存表"]},
    {"id":"agent","名称":"internal/agent","类型":"module","角色":["ReAct 主循环","ToolCall 执行与消息写回"]},
    {"id":"context","名称":"internal/context","类型":"module","角色":["消息上下文","session JSONL 与压缩"]},
    {"id":"llm","名称":"internal/llm + internal/codex","类型":"adapter","角色":["模型客户端与 provider 适配"]},
    {"id":"registry","名称":"internal/tools.Registry","类型":"registry","角色":["注册 base/skill/context 工具","显式挂载 MCP 工具"]},
    {"id":"base_tools","名称":"base.*","类型":"tool_group","角色":["文件、检索与 shell 工具"]},
    {"id":"skill","名称":"internal/skill + skill.skill","类型":"capability","角色":["加载与查询 Skill 快照"]},
    {"id":"context_tool","名称":"context.context","类型":"tool","角色":["inspect/pin/edit/audit/compress"]},
    {"id":"mcp","名称":"mcp.*","类型":"external","角色":["显式连接后的远端工具"]},
    {"id":"session_store","名称":"~/.walle/sessions/*.jsonl","类型":"storage","角色":["会话持久化"]},
    {"id":"process_output","名称":"<project>/.walle/{reports,agents}","类型":"storage","角色":["通用 process report/worklog"]}
  ],
  "边": [
    {"id":"cli->socket","from":"cli","to":"socket","关系":"attach","label":"自动复用；不存在则启动 daemon"},
    {"id":"cli->daemon","from":"cli","to":"daemon","关系":"spawn","label":"walle daemon"},
    {"id":"cli->tui","from":"cli","to":"tui","关系":"launch","label":"LaunchAttachedTUI"},
    {"id":"tui->socket","from":"tui","to":"socket","关系":"bidirectional","label":"attach/input/events/stop"},
    {"id":"daemon->runtime","from":"daemon","to":"runtime","关系":"create","label":"runtime.New(PromptBase=tui)"},
    {"id":"daemon->daemon_session","from":"daemon","to":"daemon_session","关系":"create","label":"NewDaemonSession"},
    {"id":"daemon->systemd","from":"daemon","to":"systemd","关系":"create","label":"systemd.New"},
    {"id":"socket->daemon_session","from":"socket","to":"daemon_session","关系":"route","label":"interactive"},
    {"id":"systemd->socket","from":"systemd","to":"socket","关系":"serve","label":"StartControlServer"},
    {"id":"systemd->runtime","from":"systemd","to":"runtime","关系":"sync_call","label":"ProcessRunner.RunProcess"},
    {"id":"runtime->agent","from":"runtime","to":"agent","关系":"own","label":"NewAgent"},
    {"id":"runtime->context","from":"runtime","to":"context","关系":"own","label":"NewManager/openMessageCtx"},
    {"id":"runtime->llm","from":"runtime","to":"llm","关系":"create","label":"llm.NewClient"},
    {"id":"runtime->registry","from":"runtime","to":"registry","关系":"own","label":"Init/RegisterContextTool/bindTools"},
    {"id":"agent->context","from":"agent","to":"context","关系":"read_write","label":"messages"},
    {"id":"agent->registry","from":"agent","to":"registry","关系":"execute","label":"tool calls"},
    {"id":"registry->base_tools","from":"registry","to":"base_tools","关系":"register","label":"startup"},
    {"id":"registry->skill","from":"registry","to":"skill","关系":"register","label":"startup snapshot"},
    {"id":"registry->context_tool","from":"registry","to":"context_tool","关系":"register","label":"after model creation"},
    {"id":"registry->mcp","from":"registry","to":"mcp","关系":"optional","label":"explicit connection"},
    {"id":"context->session_store","from":"context","to":"session_store","关系":"read_write","label":"append/replace"},
    {"id":"runtime->process_output","from":"runtime","to":"process_output","关系":"write","label":"generic process only"}
  ],
  "边界": [
    "Runtime 提供通用 process 执行能力；任务管理由 Skill、MCP 或外置动态工具提供。",
    "daemon 固定为 attachable interactive Agent 宿主，不接受 --poll 或 --interactive。",
    "systemd 保留通用 process.start、ProcessStartPayload 和 AgentProcess；ProcessSnapshot 使用 Name。",
    "任务管理可由 Skill、MCP 或外置动态工具提供，当前没有新增固定接口。"
  ]
}
