flowchart LR
  cli["cmd/walle"]
  tui["internal/tui"]
  daemon["walle daemon\ninteractive host"]
  socket["supervisor.sock\nlist / attach / input / stop"]
  runtime["internal/runtime"]
  session["DaemonSession"]
  systemd["internal/systemd\ngeneric process supervisor"]
  agent["internal/agent"]
  context["internal/context"]
  llm["internal/llm + codex"]
  registry["tools.Registry"]
  base["base.*"]
  skill["skill.skill"]
  context_tool["context.context"]
  mcp["mcp.*\nexplicit"]
  sessions["sessions/*.jsonl"]
  process_output["generic process\nreport / worklog"]

  cli -->|spawn when missing| daemon
  cli -->|LaunchAttachedTUI| tui
  cli -->|attach| socket
  tui <-->|events / input / stop| socket
  daemon -->|runtime.New| runtime
  daemon -->|NewDaemonSession| session
  daemon -->|systemd.New| systemd
  systemd -->|serve| socket
  socket -->|route interactive| session
  systemd -->|ProcessRunner.RunProcess| runtime
  runtime --> agent
  runtime --> context
  runtime --> llm
  runtime --> registry
  agent --> context
  agent --> registry
  registry --> base
  registry --> skill
  registry --> context_tool
  registry -.-> mcp
  context --> sessions
  runtime --> process_output
