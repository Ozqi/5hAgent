graph TD
    subgraph interface_layer["Interface layer"]
        cmd_main["cmd/5hagent/main.go"]
        cli_tui["internal/cli"]
        commands["internal/commands"]
    end

    subgraph runtime_layer["Runtime and scheduling"]
        runtime["internal/runtime"]
        event_source_task["internal/runtime/event_source_task.go"]
        systemd["internal/systemd"]
        hooks["Runtime Hooks"]
    end

    subgraph core_layer["Agent core"]
        agent["internal/agent"]
        context["internal/context"]
        llm["internal/llm"]
        logger["internal/logger"]
    end

    subgraph tools_layer["Tool layer"]
        tools_registry["internal/tools.Registry"]
        base_tools["base.* tools"]
        context_tool["context.context"]
        task_tool["task.task"]
        skill_tool["skill.skill"]
        mcp_tools["mcp.* tools"]
        task["internal/task"]
        skill["internal/skill"]
    end

    subgraph persistence_layer["Persistence and config"]
        config_env["~/.5hAgent/.env"]
        prompt_files["~/.5hAgent/prompt/*.md"]
        session_store["~/.5hAgent/sessions/*.jsonl"]
        project_task_file["project .5hagent/task.md"]
        reports["project .5hagent/reports/*.md"]
        worklogs["project .5hagent/agents/*/logs/*.md"]
    end

    cmd_main -->|runtime.New / NewInMemory| runtime
    cmd_main -->|LaunchTUI| cli_tui
    cmd_main -->|daemon| systemd
    runtime -->|LoadConfigWithOptions| config_env
    runtime -->|LoadSystemPromptBase| prompt_files
    runtime -->|task.NewTaskList| project_task_file
    runtime -->|context.NewManager| session_store
    runtime -->|llm.NewClient| llm
    runtime -->|agent.NewAgent / SetModel / SetTools| agent
    runtime -->|Registry.Init / RegisterContextTool / bindTools| tools_registry
    runtime -->|loadHookManager / handleToolEvent| hooks
    tools_registry -->|register base tools| base_tools
    tools_registry -->|register task.task| task_tool
    tools_registry -->|register skill.skill| skill_tool
    tools_registry -->|register context.context| context_tool
    tools_registry -->|RegisterMCPTools only when explicitly connected| mcp_tools
    agent -->|model.Stream / model.Generate| llm
    agent -->|GetMessages / AddMessage| context
    agent -->|toolMap lookup / invoke tool| tools_registry
    agent -->|inject enabled skills on empty context| skill
    context -->|Store.Append / ReplaceMessages| session_store
    context_tool -->|inspect / pin / edit / audit / compress| context
    task_tool -->|ExecuteTaskAction| task
    task -->|managed block| project_task_file
    skill_tool -->|list/get current skill snapshot| skill
    cli_tui -->|slash commands| commands
    cli_tui -->|RunStream| agent
    cli_tui -->|/run and /model callbacks| runtime
    agent -->|ToolEvent call/result/error| logger
    logger -->|toolEventMsg| cli_tui
    logger -->|headless/process tool events| worklogs
    hooks -->|consume stable tool events| logger
    runtime -->|writeReport / writeProcessReport| reports
    runtime -->|newHeadlessWorkLog| worklogs
    event_source_task -->|poll mtime/size| project_task_file
    event_source_task -->|task.created| systemd
    systemd -->|ProcessRunner.RunProcess| runtime
    systemd -->|process report path carried by AgentProcess| reports

